# GFB-STOCK - variables de production. Copier en deploy/.env (jamais committe)
# ou, mieux, laisser ./deploy/scripts/gen-secrets.sh generer les secrets.
# Droits recommandes : chmod 600 deploy/.env

# FORMAT : deploy.sh NE "source" PAS ce fichier, il le lit ligne par ligne (KEY=VALEUR) et
# refuse les valeurs risquees. Valeur sans guillemets : ni espace, ni " ' $ ` \ # ; & | < > ( ).
# Sinon : "entre guillemets doubles" (sans $ ` \) ou 'entre guillemets simples' (litteral).
# Un $ dans un mot de passe SMTP/API : utiliser les guillemets simples (docker compose
# interpole $ dans les valeurs sans guillemets ou en guillemets doubles).
# CRON_SECRET : uniquement [A-Za-z0-9_.~-].

# --- Domaines (DNS A/AAAA des deux noms vers l'IP du VPS AVANT le 1er demarrage)
DOMAIN=app.exemple.sn
API_DOMAIN=api.exemple.sn
ACME_EMAIL=admin@exemple.sn

# --- Donnees persistantes (bind mounts) ---
DATA_DIR=/srv/fasso/data

# --- Secrets (generes par gen-secrets.sh) ---
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
CRON_SECRET=
JWT_EXPIRY=3600

# --- E-mail Auth (reinitialisation de mot de passe) : SMTP ---
# Exemple Resend en SMTP : host smtp.resend.com, port 465, user "resend", pass = cle API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=GFB-STOCK
# deploy.sh REFUSE MAILER_AUTOCONFIRM=true en production (comptes non verifies)
MAILER_AUTOCONFIRM=false

# --- E-mail facture (Server Action de l'app + fonctions) : API Resend ---
# Valeur avec espaces ou <> : TOUJOURS entre guillemets (deploy.sh source ce fichier avec bash).
RESEND_API_KEY=
EMAIL_EXPEDITEUR="GFB-STOCK <factures@exemple.sn>"
EMAIL_REPONSE_A=

# --- Divers ---
# Duree de validite (secondes) des URL signees Storage
FACTURE_PDF_SIGNED_URL_TTL_SECONDS=3600
BON_LIVRAISON_PDF_SIGNED_URL_TTL_SECONDS=3600
EXPORT_RAPPORT_SIGNED_URL_TTL_SECONDS=3600
# Port local de Studio (127.0.0.1 uniquement -> tunnel SSH)
STUDIO_PORT=3001
APP_TAG=latest

# --- Sauvegarde (service backup) : tout est optionnel ---
# BACKUP_HOUR=02:30
# TZ=Africa/Dakar
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# KEEP_MONTHLY=6
# BACKUP_VERIFY_RESTORE=false
# --- Copie hors du VPS (rclone). Le CHIFFREMENT est OBLIGATOIRE : backup.sh refuse
# OFFSITE_ENABLED=true si le remote "offsite" n'est pas de type crypt (avec mot de passe).
# Montage : "offraw" = stockage S3/B2/R2/Wasabi brut ; "offsite" = couche crypt posee dessus.
# Les mots de passe crypt sont OBSCURCIS : `docker run --rm rclone/rclone obscure "<mdp>"`
# (les conserver HORS du VPS : sans eux, les copies sont illisibles).
# OFFSITE_ENABLED=false
# OFFSITE_REMOTE=offsite:
# OFFSITE_RETENTION_DAYS=60
# RCLONE_CONFIG_OFFRAW_TYPE=s3
# RCLONE_CONFIG_OFFRAW_PROVIDER=
# RCLONE_CONFIG_OFFRAW_ENDPOINT=
# RCLONE_CONFIG_OFFRAW_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFRAW_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFRAW_REGION=
# RCLONE_CONFIG_OFFSITE_TYPE=crypt
# RCLONE_CONFIG_OFFSITE_REMOTE=offraw:bucket/gfb
# RCLONE_CONFIG_OFFSITE_PASSWORD=
# RCLONE_CONFIG_OFFSITE_PASSWORD2=
# --- Notifications d'echec de sauvegarde ---
# NOTIFY_WEBHOOK_URL=
# NOTIFY_NTFY_URL=
# HEALTHCHECK_URL=
